  <releases>
    <release version="1.1.1" date="2026-10-07">
      <url>https://github.com/audiopadapp/audiopad/releases/tag/v1.1.1</url>
      <description>
        <p>Release of Audiopad version 1.1.1</p>
        <ul>
          <li>Fix sound image persistence and reload vanishing bug (#12)</li>
          <li>Optimize image thumbnails to eliminate memory spikes and UI lag</li>
          <li>Add Ctrl+Click multi-selection with batch image assignment and removal</li>
          <li>Set Media Grid View as default with configurable view mode setting</li>
          <li>Fix Stream Deck tile sound name visibility when no image is assigned</li>
        </ul>
      </description>
    </release>

    <release version="1.1.0" date="2026-10-07">
      <url>https://github.com/audiopadapp/audiopad/releases/tag/v1.1.0</url>
      <description>
        <p>Release of Audiopad version 1.1.0</p>
        <ul>
          <li>Resolve transport dock responsiveness and volume slider synchronization</li>
          <li>Synchronize playback start events and guard tray updates</li>
          <li>Improve seek synchronization and audio progress reporting</li>
          <li>Fix audio output routing and microphone override stability</li>
        </ul>
      </description>
    </release>
